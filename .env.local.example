# carbus-web — env template (commit me, don't commit .env.local)
# .env.local 에 실제 값을 채운다. Vercel 에는 동일 키를 환경변수로 등록.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 운영자 시스템 계정 이메일 (Supabase Dashboard 에서 생성한 viewer/master 계정)
# 비밀번호는 /admin/login 에서 사용자가 직접 입력 (코드/env 에 저장 안 함)
ADMIN_VIEWER_EMAIL=
ADMIN_MASTER_EMAIL=
